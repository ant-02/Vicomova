FROM golang:1.25-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Install kitex and generate proto code
RUN go install github.com/cloudwego/kitex/tool/cmd/kitex@latest && \
    go install github.com/cloudwego/thriftgo@latest && \
    chmod +x script/proto/gen.sh && \
    ./script/proto/gen.sh

RUN CGO_ENABLED=0 GOOS=linux go build -o /app/user ./cmd/user

FROM alpine:3.19

RUN apk --no-cache add ca-certificates

WORKDIR /app

COPY --from=builder /app/user .

EXPOSE 8888

CMD ["./user", "-config", "config/base.yaml", "-port", "8888"]
