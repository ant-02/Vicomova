database:
  host: "localhost"
  port: 3306
  user: "vicomova"
  password: "xxx"
  dbname: "vicomova"
  max_open_conns: 100
  max_idle_conns: 10

redis:
  host: "localhost"
  port: 6379
  password: "xxx"
  db: 0

kafka:
  brokers:
    - "127.0.0.1:9092"
  topic: "vicomova"

jwt:
  secret: "xxx"

email:
  access_key: "xxx"
  access_secret: "xxx"
  account_name: "mail.xhhx.xyz"
  region: "cn-hangzhou"
  api_url: "https://dm.aliyuncs.com/"

# OSS 配置（可选，用于前端直传）
oss:
  type: "qiniu"           # qiniu / aliyun / aws
  access_key: "xxx"
  secret_key: "xxx"
  bucket: "your-bucket"
  domain: "your-domain.com"

services:
  gateway:
    name: "gateway"
    addr: "127.0.0.1:8080"
  user:
    name: "user"
    addr: "127.0.0.1:8888"
  video:
    name: "video"
    addr: "127.0.0.1:8889"
  interaction:
    name: "interaction"
    addr: "127.0.0.1:8890"
