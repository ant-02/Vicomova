database:
  host: "localhost"
  port: 3306
  user: "vicomova"
  password: "xxx"
  dbname: "vicomova"
  max_open_conns: 100
  max_idle_conns: 10

redis:
  host: "localhost"
  port: 6379
  password: "xxx"
  db: 0

kafka:
  brokers:
    - "127.0.0.1:9092"
  sasl:
    username: "admin"
    password: "xxx"
  topics:
    video-view:
      name: "vicomova.video.view"
      group: "video-service"
      partitions: 3
      replication: 1
      retention_hours: 168  # 7天

jwt:
  secret: "xxx"

email:
  aliyun:
    access-key: "xxx"
    access-secret: "xxx"
    account-name: "mail.xhhx.xyz"
    region: "cn-hangzhou"
    api-url: "https://dm.aliyuncs.com/"

# OSS 配置（可选，用于前端直传）
oss:
  qiniu:
    access-key: "xxx"
    secret-key: "xxx"
    bucket: "your-bucket"
    domain: "your-domain.com"
    upload-host: "https://up-z2.qiniup.com"

services:
  user:
    name: "user"
    addr: "127.0.0.1:8888"
  video:
    name: "video"
    addr: "127.0.0.1:8889"
  interaction:
    name: "interaction"
    addr: "127.0.0.1:8890"
  chat:
    name: "chat"
    addr: "127.0.0.1:8891"
  commerce:
    name: "commerce"
    addr: "127.0.0.1:8892"
  gateway:
    name: "gateway"
    addr: "127.0.0.1:8080"