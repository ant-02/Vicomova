server:
  host: "0.0.0.0"
  port: 8080

database:
  host: "localhost"
  port: 3306
  user: "root"
  password: "password"
  dbname: "vicomova"
  max_open_conns: 100
  max_idle_conns: 10

redis:
  host: "localhost"
  port: 6379
  password: ""
  db: 0

kafka:
  brokers:
    - "127.0.0.1:9092"
  topic: "vicomova"

jwt:
  secret: "your-secret-key-change-in-production"

email:
  access_key: ""  # 从环境变量 ALIBABA_CLOUD_ACCESS_KEY_ID 读取
  access_secret: ""  # 从环境变量 ALIBABA_CLOUD_ACCESS_KEY_SECRET 读取
  account_name: "noreply@mail.xhhx.xyz"
  region: "cn-hangzhou"
  api_url: "https://dm.aliyuncs.com/"

video:
  storage:
    type: "local"  # local/qiniu/aliyun/aws
    local:
      base_path: "./static/video"
      base_url: "http://localhost:8080/static/video"
    qiniu:
      access_key: ""
      secret_key: ""
      bucket: ""
      domain: ""
    aliyun:
      access_key: ""
      secret_key: ""
      bucket: ""
      endpoint: ""
    aws:
      access_key: ""
      secret_key: ""
      bucket: ""
      region: ""

etcd:
  endpoints:
    - "127.0.0.1:2379"
  username: ""
  password: ""
  namespace: "vicomova"

services:
  user:
    addr: "127.0.0.1:8888"
  video:
    addr: "127.0.0.1:8889"
  interaction:
    addr: "127.0.0.1:8890"
  gateway:
    addr: "127.0.0.1:8080"
