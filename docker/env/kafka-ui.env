KAFKA_CLUSTERS_0_NAME=local
KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS=vicomova-kafka:9092
KAFKA_CLUSTERS_0_PROPERTIES_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_CLUSTERS_0_PROPERTIES_SASL_MECHANISM=PLAIN
KAFKA_CLUSTERS_0_SASLMECHANISM=PLAIN
KAFKA_CLUSTERS_0_SASL_USERNAME=admin
KAFKA_CLUSTERS_0_SASL_PASSWORD=admin-secret
JAVA_OPTS=-Djava.security.auth.login.config=/etc/kafka/kafka_jaas.conf